# Xero App credentials (developer.xero.com -> My Apps)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:7005/auth/xero/callback
XERO_SCOPES=openid profile email offline_access accounting.settings accounting.settings.read

# Server
PORT=4000
FRONTEND_URL=http://localhost:5005
# Any long random string in production - signs the session cookie.
SESSION_SECRET=dev-only-secret-change-me
NODE_ENV=development

# Tunables (all optional - defaults live in src/config/constants.js)
BATCH_SIZE=50
MAX_RETRIES=5
XERO_MAX_CONCURRENT_REQUESTS=5
XERO_MAX_REQUESTS_PER_MINUTE=60
MAX_UPLOAD_BYTES=52428800
